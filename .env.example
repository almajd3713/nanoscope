# Never commit real tokens. On Kaggle, add these as notebook secrets.
HF_TOKEN=
WANDB_API_KEY=

# docker compose (see compose.yaml)
NANOSCOPE_TOKEN=            # leave empty: the API makes one in the home volume and logs the login URL
NANOSCOPE_PORT=8765         # the port on 127.0.0.1 that the API is published on
NANOSCOPE_WORKSPACE=./workspace   # your models and studies, bind-mounted into the containers
NANOSCOPE_SLOTS=1           # jobs at once per worker
NANOSCOPE_JOBS_OFFLINE=     # 1: jobs that need the network are refused
NANOSCOPE_LSP_PORT=8767     # the editor's language server (docker compose --profile editor-lsp up -d lsp)
NANOSCOPE_LSP_ORIGINS=      # pages beyond this machine's that may use it (comma separated origins)
