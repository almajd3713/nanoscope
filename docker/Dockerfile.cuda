# CUDA image: docker build -f docker/Dockerfile.cuda -t nanoscope:cuda .
# Run it with the NVIDIA container toolkit (`--gpus all`, or the compose gpu profile).
FROM python:3.12-slim AS build
RUN pip install --no-cache-dir uv
WORKDIR /src
COPY pyproject.toml LICENSE README.md Makefile ./
# the dependency list alone (no torch: the next stage has it), so the layer that installs it is
# rebuilt only when pyproject.toml changes, not on every code edit
RUN python - <<'PY'
import tomllib
p = tomllib.load(open("pyproject.toml", "rb"))["project"]
deps = p["dependencies"] + p["optional-dependencies"]["server"] + p["optional-dependencies"]["notebook"]
open("/requirements.txt", "w").write("\n".join(d for d in deps if not d.startswith("torch")) + "\n")
PY
COPY nanoscope ./nanoscope
RUN uv build --wheel --out-dir /dist

# pinned: torch and the CUDA runtime come with the base image, so the wheel's `torch>=2.2` is satisfied
FROM pytorch/pytorch:2.8.0-cuda12.6-cudnn9-runtime
COPY --from=build /requirements.txt /tmp/requirements.txt
# uv (mounted from the build stage, so it is not in the final image) installs the rest; the cache
# mount keeps downloads between builds (a flaky network resumes instead of restarting)
ENV UV_HTTP_TIMEOUT=120 UV_LINK_MODE=copy
RUN --mount=from=build,source=/usr/local/bin/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r /tmp/requirements.txt
COPY --from=build /dist/*.whl /tmp/
RUN --mount=from=build,source=/usr/local/bin/uv,target=/usr/local/bin/uv \
    uv pip install --system --no-cache --no-deps /tmp/nanoscope_lab-*.whl && rm /tmp/*.whl

# git: the workspace is a git repository (preregistration commits); safe.directory because a bind
# mount is owned by whoever made it. The directories exist so named volumes start owned by uid 1000.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory /nanoscope/workspace
RUN useradd --uid 1000 --create-home nanoscope \
    && mkdir -p /nanoscope/workspace /data /hf-cache /compile-cache \
    && chown -R 1000:1000 /nanoscope /data /hf-cache /compile-cache
USER 1000
ENV NANOSCOPE_HOME=/nanoscope
VOLUME /nanoscope
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/api/health', timeout=4)"
CMD ["nanoscope", "serve", "--host", "0.0.0.0"]
