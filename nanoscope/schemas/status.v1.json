{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoscope.dev/schemas/status.v1.json",
  "title": "status.v1",
  "description": "A run's status.json: its lifecycle state, rewritten atomically while it runs.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "nanoscope": {
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "done",
        "stopped",
        "cancelled",
        "failed"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "traceback": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    "pid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "device": {
      "type": [
        "string",
        "null"
      ]
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "max_steps": {
      "type": [
        "integer",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string"
    },
    "heartbeat_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "state",
    "updated_at"
  ]
}
