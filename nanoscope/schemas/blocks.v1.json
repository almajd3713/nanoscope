{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoscope.dev/schemas/blocks.v1.json",
  "title": "blocks.v1",
  "description": "The palette catalog from `nanoscope blocks --json`: every block a model can be composed from, with its options, reference function and whether it is certified against it.",
  "type": "object",
  "required": [
    "schema",
    "nanoscope",
    "blocks",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "nanoscope": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "error"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "arg": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": true
      }
    },
    "block": {
      "type": "object",
      "required": [
        "name",
        "family",
        "tier",
        "module",
        "args",
        "doc",
        "reference",
        "features",
        "user",
        "certified",
        "file",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "primitive",
            "composite"
          ]
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arg"
          }
        },
        "doc": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user": {
          "type": "boolean"
        },
        "certified": {
          "type": "boolean"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
