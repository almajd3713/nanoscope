{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoscope.dev/schemas/comparison.v1.json",
  "title": "comparison.v1",
  "description": "The result of compare(): one row per run set, each with a verdict against the baseline.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "nanoscope": {
      "type": "string"
    },
    "metric": {
      "enum": [
        "val_bpb",
        "val_loss"
      ]
    },
    "baseline": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "seeds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "params": {
            "type": "integer"
          },
          "tokens": {
            "type": "integer"
          },
          "summary": {
            "type": "object"
          },
          "delta": {
            "type": [
              "object",
              "null"
            ]
          },
          "verdict": {
            "enum": [
              "baseline",
              "better",
              "worse",
              "within noise",
              "no CI"
            ]
          },
          "params_kind": {
            "enum": [
              "non-embedding",
              "total"
            ]
          }
        },
        "required": [
          "label",
          "seeds",
          "summary",
          "delta",
          "verdict"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "source",
          "seeds"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "seeds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "seed",
                "points"
              ],
              "properties": {
                "seed": {
                  "type": "integer"
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          }
        }
      }
    },
    "precision_plan": {
      "type": "object",
      "required": [
        "metric",
        "preset",
        "n_seeds",
        "sd",
        "half_width",
        "source"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "preset": {
          "type": "string"
        },
        "n_seeds": {
          "type": "integer"
        },
        "sd": {
          "type": [
            "number",
            "null"
          ]
        },
        "half_width": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema",
    "metric",
    "baseline",
    "rows",
    "notes"
  ]
}
