{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoscope.dev/schemas/job.v1.json",
  "title": "job.v1",
  "description": "A queued job: its kind and the payload that kind needs. Payloads carry refs and plain data, never code.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "run",
        "prepare-data",
        "bench"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "kind",
    "payload"
  ],
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "run"
        },
        "payload": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "preset": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer"
            },
            "kwargs": {
              "type": "object"
            },
            "wandb": {
              "type": [
                "boolean",
                "string"
              ]
            },
            "push_to_hub": {
              "type": [
                "string",
                "null"
              ]
            },
            "overrides": {
              "type": "object"
            },
            "custom_preset": {
              "type": "object"
            },
            "checkpoint_steps": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "compile": {
              "type": [
                "boolean",
                "string"
              ]
            },
            "study": {
              "type": [
                "object",
                "null"
              ]
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "model",
            "preset"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "prepare-data"
        },
        "payload": {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "preset"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "bench"
        },
        "payload": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "preset": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "device": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "model"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "check"
        },
        "payload": {
          "type": "object",
          "properties": {
            "lesson": {
              "type": "string",
              "minLength": 1
            },
            "variant": {
              "enum": [
                "cpu",
                "gpu"
              ]
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "lesson"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "describe"
        },
        "payload": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "preset": {
              "type": "string",
              "minLength": 1
            },
            "kwargs": {
              "type": "object"
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "model"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "generate"
        },
        "payload": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string"
            },
            "max_new_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "temperature": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "seed": {
              "type": "integer"
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "study"
        },
        "payload": {
          "type": "object",
          "properties": {
            "spec": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "spec"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "sync-hub"
        },
        "payload": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "repo",
            "ref"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "certify"
        },
        "payload": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "block": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "file",
            "block"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "sizes"
        },
        "payload": {
          "type": "object",
          "properties": {
            "spec": {
              "type": "object"
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "spec"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "study-spec"
        },
        "payload": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "prereg-preview"
        },
        "payload": {
          "type": "object",
          "properties": {
            "spec": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "spec"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "commit"
        },
        "payload": {
          "type": "object",
          "properties": {
            "spec": {
              "type": "string",
              "minLength": 1
            },
            "preview_hash": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "spec",
            "preview_hash"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "card-push"
        },
        "payload": {
          "type": "object",
          "properties": {
            "card": {
              "type": "string",
              "minLength": 1
            },
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "card",
            "repo"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "inspect"
        },
        "payload": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string"
            },
            "step": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "top_k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
