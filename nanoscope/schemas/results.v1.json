{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoscope.dev/schemas/results.v1.json",
  "title": "results.v1",
  "description": "A study report's results.json: the comparison table and checked predictions.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "nanoscope": {
      "type": "string"
    },
    "study": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "manifest": {
      "type": [
        "object",
        "null"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "predictions": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "study",
    "mode",
    "rows",
    "notes",
    "predictions"
  ]
}
